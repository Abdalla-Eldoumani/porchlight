# Copy to .env and fill in. Everything is optional: with nothing set the
# server runs the replay in memory, with sign-in off and template messages.

# Tiger Data (Timescale) connection string; add ?sslmode=require
DATABASE_URL=
# Google AI Studio key; GEMINI_MODEL defaults to gemini-3.6-flash
GEMINI_API_KEY=
GEMINI_MODEL=
# AESO developer portal key (Current Supply Demand API), for live mode
AESO_API_KEY=
# Auth0: single-page application + API
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
# Shared secret between the server and the real box
PORCHLIGHT_DEVICE_KEY=
# Set this to give volunteers unguessable links instead of the demo ones
PORCHLIGHT_LINK_SECRET=
# Your domain, for HTTPS on the server (used by Caddy)
DOMAIN=
